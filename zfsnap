    case "$_arg" in
      --*=*) _newargs="$_newargs ${_arg%%=*} ${_arg#*=}" ;;
      -*[!-]*)  
        _flag="${_arg%${_arg#??}}"
        _rest="-${_arg#??}"
        if [ ${#_arg} -gt 2 ] && [ "$_rest" != "-" ]; then
          _newargs="$_newargs $_flag $_rest"
        else
          _newargs="$_newargs $_arg"
        fi ;;
      *) _newargs="$_newargs $_arg" ;;
    esac
  done
  eval set -- $_newargs
}


