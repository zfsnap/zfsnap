  # make sure it contains a date
  [ -z "${snapshot_name##*$DATE_PATTERN*}" ] || { RETVAL=''; return 1; }

  local pre_date="${snapshot_name%$DATE_PATTERN*}"
  local post_date="${snapshot_name##*$DATE_PATTERN}"

